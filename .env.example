# Copy to .env locally. NEVER commit .env; the key must never leave your machine.
TYPESAFE_API_KEY=REPLACE_WITH_NEW_KEY_LOCALLY
TYPESAFE_BASE_URL=https://api.typesafe.ai
# pinned: every reported experiment used jev-1.13.0; "jev-latest" would change results silently
JEV_MODEL=jev-1.13.0
JEV_ENABLED=false
JEV_MAX_CALLS_PER_RUN=2000
JEV_DAILY_BUDGET_USD=5.00
SIMULATION_MODE=true
CONTROL_TARGET=VIRTUAL_PLC_ONLY
